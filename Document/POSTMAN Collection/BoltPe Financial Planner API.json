              "body": "{\n  \"schemes\": [\n    \"http\",\n    \"https\"\n  ],\n  \"swagger\": \"2.0\",\n  \"info\": {\n    \"description\": \"BoltPe-owned Financial Planner APIs. Requests are validated before the internal Planning Engine runs. Goal timeline validation is strict: Instant goals require 6-12 months, Short goals 1-5 years, and Long goals 20-25 years. The timeline text must use the correct unit and match the numeric months/years field. Policy Planner is not used at runtime.\",\n    \"title\": \"BoltPe Financial Planner API\",\n    \"contact\": {},\n    \"version\": \"1.2.0\"\n  },\n  \"basePath\": \"/\",\n  \"paths\": {\n    \"/api/financial-planner/report\": {\n      \"post\": {\n        \"description\": \"Validates the request, runs the BoltPe-owned Planning Engine, persists the report and returns the report response. No Policy Planner/vendor call is used.\",\n        \"consumes\": [\n          \"application/json\"\n        ],\n        \"produces\": [\n          \"application/json\"\n        ],\n        \"tags\": [\n          \"Reports\"\n        ],\n        \"summary\": \"Generate BoltPe financial planner report\",\n        \"operationId\": \"post_financial_planner_report\",\n        \"parameters\": [\n          {\n            \"description\": \"Financial planner request\",\n            \"name\": \"request\",\n            \"in\": \"body\",\n            \"required\": true,\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.FinancialPlannerRequest\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.GenerateReportSuccessResponse\"\n            }\n          },\n          \"400\": {\n            \"description\": \"VAL_001 - validation failed, including Goal Master and timeline rules\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"429\": {\n            \"description\": \"Too Many Requests\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"500\": {\n            \"description\": \"BoltPe calculation, report generation, or storage error\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          }\n        }\n      }\n    },\n    \"/api/financial-planner/report-json\": {\n      \"post\": {\n        \"description\": \"Validates the request, creates the database audit row, runs the internal BoltPe Planning Engine, stores and returns structured JSON. After the JSON response is ready, PDF generation, S3 upload and email delivery continue in the background. Goal timeline validation is strict: Instant 6-12 Months; Short 1-5 Years; Long 20-25 Years; timeline text must match months/years. API-key and X-User-ID route validation are currently disabled in code.\",\n        \"consumes\": [\n          \"application/json\"\n        ],\n        \"produces\": [\n          \"application/json\"\n        ],\n        \"tags\": [\n          \"Financial Planner Reports\"\n        ],\n        \"summary\": \"Generate structured BoltPe financial planner JSON\",\n        \"operationId\": \"generate_structured_financial_planner_json\",\n        \"parameters\": [\n          {\n            \"description\": \"Financial planner request\",\n            \"name\": \"request\",\n            \"in\": \"body\",\n            \"required\": true,\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.FinancialPlannerRequest\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Structured report generated successfully\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.StructuredJSONReportResponse\"\n            }\n          },\n          \"400\": {\n            \"description\": \"VAL_001 - request, customer, family, insurance, cashflow, goal key/label/type/timeline or assumption validation failed\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"413\": {\n            \"description\": \"Request body exceeds the configured limit\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"429\": {\n            \"description\": \"Rate limit exceeded\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"500\": {\n            \"description\": \"BoltPe calculation, serialization, database, PDF-background setup, or internal processing error\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          }\n        }\n      }\n    },\n    \"/api/financial-planner/report-pdf-direct\": {\n      \"post\": {\n        \"description\": \"Validates the request, runs the same BoltPe Planning Engine and returns the PDF directly. This endpoint does not automatically send email.\",\n        \"consumes\": [\n          \"application/json\"\n        ],\n        \"produces\": [\n          \"application/pdf\"\n        ],\n        \"tags\": [\n          \"Reports\"\n        ],\n        \"summary\": \"Generate and download a financial planner PDF\",\n        \"operationId\": \"post_financial_planner_report_pdf_direct\",\n        \"parameters\": [\n          {\n            \"description\": \"Financial planner request\",\n            \"name\": \"request\",\n            \"in\": \"body\",\n            \"required\": true,\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.FinancialPlannerRequest\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"schema\": {\n              \"type\": \"file\"\n            }\n          },\n          \"400\": {\n            \"description\": \"VAL_001 - validation failed, including Goal Master and timeline rules\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"429\": {\n            \"description\": \"Too Many Requests\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"500\": {\n            \"description\": \"BoltPe calculation, persistence or PDF generation error\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          }\n        }\n      }\n    },\n    \"/api/financial-planner/reports\": {\n      \"get\": {\n        \"description\": \"Returns stored report metadata in descending creation order and refreshes signed report URLs where applicable. API-key/X-User-ID validation is currently disabled; current controller uses user ID 1.\",\n        \"produces\": [\n          \"application/json\"\n        ],\n        \"tags\": [\n          \"Financial Planner Reports\"\n        ],\n        \"summary\": \"List stored financial planner reports\",\n        \"operationId\": \"list_financial_planner_reports\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Reports fetched successfully\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/FinancialPlanner.ListReportsResponse\"\n            }\n          },\n          \"500\": {\n            \"description\": \"Unable to fetch reports from the database\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          }\n        },\n        \"parameters\": []\n      }\n    },\n    \"/api/financial-planner/smtp-status\": {\n      \"get\": {\n        \"description\": \"Returns local BoltPe SMTP configuration status. Access is restricted by allowed-IP middleware.\",\n        \"produces\": [\n          \"application/json\"\n        ],\n        \"tags\": [\n          \"Email\"\n        ],\n        \"summary\": \"Get email-service status\",\n        \"operationId\": \"get_financial_planner_smtp_status\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/FinancialPlanner.SMTPStatusResponse\"\n            }\n          },\n          \"403\": {\n            \"description\": \"AUTH_403 - client IP is not allowed\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          }\n        }\n      }\n    },\n    \"/api/financial-planner/test-email\": {\n      \"post\": {\n        \"description\": \"Sends a test email directly through the configured BoltPe SMTP mailer. Access is restricted by allowed-IP middleware.\",\n        \"consumes\": [\n          \"application/json\"\n        ],\n        \"produces\": [\n          \"application/json\"\n        ],\n        \"tags\": [\n          \"Email\"\n        ],\n        \"summary\": \"Send a test email\",\n        \"operationId\": \"post_financial_planner_test_email\",\n        \"parameters\": [\n          {\n            \"description\": \"Test email request\",\n            \"name\": \"request\",\n            \"in\": \"body\",\n            \"required\": true,\n            \"schema\": {\n              \"$ref\": \"#/definitions/FinancialPlanner.TestEmailRequest\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/FinancialPlanner.TestEmailResponse\"\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"403\": {\n            \"description\": \"AUTH_403 - client IP is not allowed\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          },\n          \"500\": {\n            \"description\": \"FP_EMAIL_001 - SMTP/email sending failed\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/models.APIErrorResponse\"\n            }\n          }\n        }\n      }\n    },\n    \"/financial-planner/\": {\n      \"get\": {\n        \"description\": \"Returns the BoltPe Financial Planner application home page.\",\n        \"produces\": [\n          \"text/html\"\n        ],\n        \"tags\": [\n          \"Pages\"\n        ],\n        \"summary\": \"Render the Financial Planner home page\",\n        \"operationId\": \"get_financial_planner_home\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"HTML page\",\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    },\n    \"/financial-planner/health\": {\n      \"get\": {\n        \"description\": \"Returns the current BoltPe Financial Planner service status.\",\n        \"produces\": [\n          \"application/json\"\n        ],\n        \"tags\": [\n          \"Pages\"\n        ],\n        \"summary\": \"Check Financial Planner service health\",\n        \"operationId\": \"get_financial_planner_health\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\",\n            \"schema\": {\n              \"$ref\": \"#/definitions/routes.HealthResponse\"\n            }\n          }\n        }\n      }\n    },\n    \"/api/financial-planner/reports/{reportPath}\": {\n      \"get\": {\n        \"description\": \"Serves a generated report through a signed and expiring URL.\",\n        \"produces\": [\n          \"application/pdf\"\n        ],\n        \